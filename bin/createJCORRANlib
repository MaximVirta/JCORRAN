#!/bin/bash
set -e
CURDIR=$PWD
JCORRAN_PATH=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )"/.. &> /dev/null && pwd )
export PATH="$JCORRAN_PATH/bin:$PATH"

mkdir -p "$JCORRAN_PATH/lib"
rm -f "$JCORRAN_PATH/lib/"*
cd "$JCORRAN_PATH/include"
echo "Generating ROOT dictionary for the JCORRAN..."
# LinkDef.h must be last. Exclude leftover rootcling temps from the glob.
rootcling -f "$JCORRAN_PATH/src/Base/jcorranDict.cxx" \
  Ali*.h JTreeDataManager.h LinkDef.h \
  -s "$JCORRAN_PATH/lib/JCORRANdict" \
  -rml "$JCORRAN_PATH/lib/libJCORRANdict.so" \
  -rmf "$JCORRAN_PATH/lib/libJCORRANdict.rootmap"

cd "$JCORRAN_PATH/src/Base"
rm -f *.o jcorranDict.cxx_tmp_*
echo "Creating JCORRAN lib to $JCORRAN_PATH/lib"
echo "Compiling objects..."
# Compile only real sources plus the generated dictionary, not editor backups.
g++ -c Ali*.cxx JTreeDataManager.cxx jcorranDict.cxx $( root-config --cflags ) -I"$JCORRAN_PATH/include" -fPIC
echo "Creating a shared library for ROOT..."
g++ -fPIC --shared $(root-config --cflags --libs) -I"$JCORRAN_PATH/include" \
  -o "$JCORRAN_PATH/lib/libJCORRANdict.so" \
  Ali*.cxx JTreeDataManager.cxx jcorranDict.cxx
ar rcs "$JCORRAN_PATH/lib/libJCORRANbase.a" *.o && echo "JCorran library created succesfully!"
cd "$CURDIR"
